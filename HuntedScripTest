-- HUNTED [IN PROGRESS]

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-- Services

local Players = game:GetService("Players")

local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local MarketplaceService = game:GetService("MarketplaceService")

local GameName = MarketplaceService:GetProductInfo(game.PlaceId).Name

-- Variables

local MonsterESP = false

local MonsterHighlights = {}

local portal

task.spawn(function()
    local portals = workspace:WaitForChild("Portals")

    repeat
        local exitPortal = portals:FindFirstChild("ExitPortal")
        if exitPortal then
            portal = exitPortal:WaitForChild("Zone")
            break
        end
        task.wait(1)
    until false
end)

local CollectShards = false

local Window = Rayfield:CreateWindow({
    Name = GameName,
    Icon = 0,
    LoadingTitle = "script",
    LoadingSubtitle = "shit",
    ShowText = "Rayfield",
    Theme = "Default",
    ToggleUIKeybind = "K",
    DisableRayfieldPrompts = true,
    DisableBuildWarnings = true
})

-- Tabs

local Tab1 = Window:CreateTab("Game", 4483362458)
local Tab2 = Window:CreateTab("Teleport", 4483362458)
local Tab3 = Window:CreateTab("Esp", 4483362458)

-- Toggles

Tab1:CreateToggle({
    Name = "Collect Shards",
    CurrentValue = false,
    Callback = function(Value)
        CollectShards = Value

        if CollectShards then
            task.spawn(function()
                while CollectShards do
                    task.wait(0.3)

                    local character = player.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")

                    if root then
                        for _, v in pairs(Workspace:GetDescendants()) do
                            if not CollectShards then
                                break
                            end

                            if v:IsA("TouchTransmitter") and v.Parent and (v.Parent.Name == "Shard" or v.Parent.Name:lower():match("shard")) then
                                local shardPart = v.Parent
                                if shardPart:IsA("BasePart") then
                                    firetouchinterest(root, shardPart, 0)
                                    task.wait(0.005)
                                    firetouchinterest(root, shardPart, 1)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
})

Tab3:CreateToggle({
    Name = "Esp Monsters",
    CurrentValue = false,
    Callback = function(Value)
        MonsterESP = Value

        if MonsterESP then
            task.spawn(function()
                while MonsterESP do
                    for _, v in ipairs(Workspace.NPCs:GetChildren()) do
                        if v:IsA("Model") and not MonsterHighlights[v] then
                            local hl = Instance.new("Highlight")
                            hl.Name = "MonsterESP"
                            hl.Adornee = v
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.FillTransparency = 0.5
                            hl.OutlineTransparency = 0
                            hl.Parent = v

                            MonsterHighlights[v] = hl
                        end
                    end
                    task.wait(1)
                end
            end)
        else
            for model, hl in pairs(MonsterHighlights) do
                if hl then
                    hl:Destroy()
                end
            end
            table.clear(MonsterHighlights)
        end
    end
})

-- Buttons

Tab1:CreateButton({
    Name = "Get Ring Piece",
    Callback = function()
        fireclickdetector(workspace.RingPiece.Statue.ClickDetector)
    end
})

Tab1:CreateButton({
    Name = "Escape [End The Game]",
    Callback = function()
        if not portal then
            return
        end

        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

        if root then
            firetouchinterest(root, portal, 0)
            task.wait(0.05)
            firetouchinterest(root, portal, 1)
        end
    end
})

Tab2:CreateButton({
    Name = "Teleport To Statue",
    Callback = function()

        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local statue = workspace:FindFirstChild("RingPiece") and workspace.RingPiece:FindFirstChild("Statue")

        if root and statue then
            root.CFrame = statue.CFrame + Vector3.new(0, 5, 0)
        end
    end
})
